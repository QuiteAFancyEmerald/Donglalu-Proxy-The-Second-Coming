{
  "name": "dlpcc",
  "version": "0.2.0",
  "description": "Self-hosted TURN on your Node server's own port: a prebuilt Go relay plus a Node wrapper that runs it and signs credentials, with a Scramjet plugin that routes proxied pages' WebRTC through it.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuiteAFancyEmerald/Donglalu-Proxy-The-Second-Coming.git"
  },
  "homepage": "https://github.com/QuiteAFancyEmerald/Donglalu-Proxy-The-Second-Coming#readme",
  "bugs": {
    "url": "https://github.com/QuiteAFancyEmerald/Donglalu-Proxy-The-Second-Coming/issues"
  },
  "keywords": [
    "turn",
    "webrtc",
    "relay",
    "wisp",
    "scramjet",
    "proxy"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./path": {
      "types": "./dist/path.d.ts",
      "default": "./dist/path.js"
    },
    "./scramjet": {
      "types": "./src/scramjet.d.ts",
      "default": "./src/scramjet.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "src/client.js",
    "src/scramjet.js",
    "src/scramjet.d.ts"
  ],
  "scripts": {
    "build:bins": "node scripts/build-bins.mjs",
    "build": "tsc",
    "test": "go test ./relay && npm run build && node --test \"test/*.test.mjs\"",
    "prepack": "npm run build:bins && npm run build"
  },
  "peerDependencies": {
    "@mercuryworkshop/scramjet-controller": "*"
  },
  "peerDependenciesMeta": {
    "@mercuryworkshop/scramjet-controller": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
