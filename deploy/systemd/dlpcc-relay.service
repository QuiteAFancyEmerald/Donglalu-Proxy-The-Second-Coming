[Unit]
Description=DLPCC TURN relay
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/dlpcc/relay.env
ExecStart=/usr/local/bin/dlpcc-relay
Restart=on-failure
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
