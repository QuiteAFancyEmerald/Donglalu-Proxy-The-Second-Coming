# /etc/dlpcc/relay.env  (chmod 600)
# Generate with: openssl rand -hex 32
DLPCC_SECRET=change-me

# Public IPv4 of this server.
DLPCC_RELAY_IP=203.0.113.10

# Open this UDP range in your firewall.
DLPCC_RELAY_PORTS=49152-65535

DLPCC_TURN_LISTEN=127.0.0.1:3478

# Set to empty if your Node app mints credentials with the npm package instead.
DLPCC_HTTP_LISTEN=127.0.0.1:8090

# Leave empty to allow any hostname nginx forwards, or restrict:
# DLPCC_HOSTS=example.com,*.example2.com

# DLPCC_TTL=12h
# DLPCC_MAX_ALLOCS_PER_USER=8
# DLPCC_MAX_ALLOCS=1000
# Only relay to these networks (e.g. your streaming provider's ranges):
# DLPCC_ALLOW_PEERS=
