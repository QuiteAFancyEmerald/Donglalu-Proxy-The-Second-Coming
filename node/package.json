{
  "name": "dlpcc",
  "version": "0.1.0",
  "description": "TURN relay for WebRTC behind a proxy, with prebuilt binaries and a Node wrapper: spawn it, mint credentials, serve the client patch.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuiteAFancyEmerald/DLPCC.git",
    "directory": "node"
  },
  "keywords": [
    "turn",
    "webrtc",
    "relay",
    "wisp",
    "scramjet",
    "proxy"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./path": {
      "types": "./dist/path.d.ts",
      "default": "./dist/path.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "client.js"
  ],
  "scripts": {
    "build:bins": "node scripts/build-bins.mjs",
    "build": "node scripts/copy-client.mjs && tsc",
    "prepack": "npm run build:bins && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
