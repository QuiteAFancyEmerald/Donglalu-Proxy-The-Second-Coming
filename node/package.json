{
  "name": "dlpcc",
  "version": "0.1.0",
  "description": "Node wrapper for the DLPCC TURN relay: spawn it, mint credentials, serve the WebRTC client patch.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "client.js"
  ],
  "scripts": {
    "build": "node scripts/copy-client.mjs && tsc",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
